# Configuración del nodo BFA. docker-compose.yml lee estas variables
# automáticamente (docker compose carga .env del mismo directorio).

# Imagen: "latest" = red de producción, "test" = test2network (testnet)
BFANODO_IMAGE=bfaar/nodo
BFANODO_TAG=latest
# La imagen oficial solo se publica para linux/amd64; en Mac Apple Silicon
# corre emulada (Rosetta). En un servidor Linux amd64 no hace falta, pero no
# molesta dejarla.
BFANODO_PLATFORM=linux/amd64

BFANODO_CONTAINER_NAME=bfanodo
BFANODO_RESTART_POLICY=unless-stopped
BFANODO_MEM_LIMIT=6g

# Carpeta en disco donde persiste la blockchain (bind mount, no volumen
# Docker). Tiene que existir de antemano. Acá: disco externo "Extreme SSD".
BFANODO_DATA_DIR=/Volumes/Extreme SSD/bfanodo-data

# Dirección donde se publican los puertos JSON-RPC en el host. 127.0.0.1
# los deja accesibles solo desde esta máquina; poné 0.0.0.0 (o una IP
# específica) si necesitás exponerlos a otras máquinas de tu red o a
# internet.
BFANODO_RPC_BIND=127.0.0.1
BFANODO_HTTP_PORT=8545
BFANODO_WS_PORT=8546
# P2P: queda abierto al mundo (sin BFANODO_RPC_BIND) para que el nodo
# pueda descubrir peers y sincronizar.
BFANODO_P2P_PORT=30303

BFANODO_HEALTHCHECK_INTERVAL=30s
BFANODO_HEALTHCHECK_TIMEOUT=5s
BFANODO_HEALTHCHECK_START_PERIOD=30s
BFANODO_HEALTHCHECK_RETRIES=3
